<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Custom Approval Trace</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__AppPage,lightning__RecordPage">
            <property label="Items to Show" name="itemsToShow" type="String" datasource="Show All, Assigned Only, Completed" default="Assigned Only" description="Filters the table of Work Items by Status. 'Assigned Only' shows Work Items that are assigned but not yet approved. 'Completed' shows only Work Items that have been approved or rejected."/>
            <property label="Label" name="label" type="String" default="Items to Approve"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>